{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/tableway-landing run build",
  "outputDirectory": "artifacts/tableway-landing/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "build": {
    "env": {
      "PORT": "22934",
      "BASE_PATH": "/"
    }
  },
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/detected-country",
      "destination": "https://app.tableway.app/api/detected-country"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tableflow-production-4662.up.railway.app/api/:path*"
    },
    {
      "source": "/book/:path*",
      "destination": "https://app.tableway.app/book/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://app.tableway.app/assets/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://app.tableway.app/brand/:path*"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|favicon\\.png|favicon\\.svg|web-assets/).*)",
      "destination": "/index.html"
    }
  ]
}
